# ============================================================================
# E.D.V.I.S. BRAIN SERVER - ENVIRONMENT CONFIGURATION (SUPABASE EDITION)
# ============================================================================

# Server Settings
PORT=8080
HOST=0.0.0.0
EDVIS_AUTH_TOKEN=edvis-tactical-secret-token

# Google Gemini API (Gemini 3.8 Live Audio & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VOICE_NAME=Fenrir

# Supabase Configuration (Project URL + Service Role or Anon Key)
# Used for Finance App (https://visionary-frangipane-a8c9fa.netlify.app/)
# and E.D.V.I.S. pgvector Continuous Memory
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional Direct PostgreSQL Connection String (Supabase Pooler / Direct URI)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Table Names
FINANCE_TABLE_NAME=transactions
MEMORY_TABLE_NAME=edvis_memories
FINANCE_DEFAULT_USER_ID=

# Vantage Markets / MetaTrader 5 Credentials
PYTHON_EXECUTABLE=python
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=VantageInternational-Demo
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_DEVIATION=20
MT5_MAGIC_NUMBER=990011

# Google Maps / Routes API (Dynamic Traffic Bypass)
GOOGLE_MAPS_API_KEY=your_google_maps_routes_api_key
