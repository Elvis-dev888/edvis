    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
