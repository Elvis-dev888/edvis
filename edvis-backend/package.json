{
  "name": "edvis-backend",
  "version": "1.0.0",
  "description": "E.D.V.I.S. (Electronic Direct Vision Intelligence System) Tactical Brain Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
